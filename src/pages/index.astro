---
import { siteConfig } from '../lib/siteConfig';
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactDialog from '../components/ContactDialog.astro';
import TechStack from '../components/TechStack.astro';
const locale = 'ru';
const title = "DevOps и backend для бизнеса — Let's make IT";
const description = 'DevOps, IT-аутсорсинг и backend-разработка для бизнеса. Поддержка IT-инфраструктуры, API и автоматизация процессов. Коммерческая разработка с 2005 года.';
const socialDescription = 'Поддерживаем IT-инфраструктуру, автоматизируем процессы и разрабатываем backend. Инженерная экспертиза — на службе бизнес-целей.';
---
<SiteLayout locale={locale} title={title} description={description} socialDescription={socialDescription}>

  <header class="header">
    <a class="brand" href="#top" aria-label="Let's make IT — на главную">
      <img src="assets/logo.svg" alt=""><span class="brand-name">Let's make IT</span>
    </a>
    <nav class="nav" aria-label="Основная навигация">
      <a href="#services">Услуги</a><a href="#techcard">Технологии</a><a href="#approach">Подход</a><a href="#about">О нас</a>
    </nav>
    <a class="language-switch" href="en/?lang=en" hreflang="en" lang="en" aria-label="English version">EN</a>
    <a class="header-cta" href="#contact" data-open-contact>Обсудить задачу <span>↗</span></a>
    <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false"><span></span><span></span></button>
  </header>

  <main id="top">
    <section class="hero wrap">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> Технологический партнёр для бизнеса <span class="eyebrow-line"></span> 01 / 05</div>
        <h1>Технологии<br>для роста <span class="accent">бизнеса.</span></h1>
        <p class="hero-text">Помогаем развивать продукты и держать IT под контролем: поддерживаем инфраструктуру, берём на себя технические задачи и создаём backend. Инженерная экспертиза — на службе ваших бизнес-целей.</p>
        <div class="hero-actions"><a class="button button-primary" href="#contact" data-open-contact>Расскажите о проекте <span>↗</span></a><a class="text-link" href="#services">Чем можем помочь <span>↓</span></a></div>
        <div class="hero-meta"><span>Деловой подход</span><span>·</span><span>Инженерная экспертиза</span><span>·</span><span>Решения для роста</span></div>
      </div>
      <div class="hero-art" aria-label="Иллюстрация архитектуры инфраструктуры">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="art-grid"></div>
        <div class="terminal-card"><div class="terminal-top"><span></span><span></span><span></span><b>deploy.sh</b></div><div class="terminal-body"><p><i>$</i> infrastructure.apply()</p><p class="terminal-muted">Planning infrastructure...</p><p class="terminal-success">✓ 12 resources ready</p><p><i>$</i> service.status</p><div class="health"><span>API</span><div><i></i></div><b>operational</b></div><div class="health"><span>DB</span><div><i></i></div><b>operational</b></div><div class="health"><span>CI/CD</span><div><i></i></div><b>operational</b></div><p class="cursor-line"><i>$</i> <span class="cursor"></span></p></div></div>
        <div class="floating-tag tag-top"><span class="tag-icon">↗</span><div><b>Стабильность</b><small>в основе решений</small></div></div>
        <div class="floating-tag tag-bottom"><span class="tag-icon green">⌘</span><div><b>Built to scale</b><small>готово к росту</small></div></div>
        <div class="art-index">INFRASTRUCTURE / 001</div>
      </div>
      <a href="#services" class="scroll-hint"><span></span> Листайте вниз</a>
    </section>

    <section class="services section" id="services"><div class="wrap">
      <div class="section-head"><div><div class="eyebrow"><span class="section-no">01</span> ЧТО МЫ ДЕЛАЕМ</div><h2>IT с пользой<br><span class="muted">для бизнеса.</span></h2></div><p>Поддерживаем инфраструктуру, берём на себя IT-задачи и разрабатываем backend — чтобы команда могла сосредоточиться на продукте и клиентах.</p></div>
      <div class="service-grid">
        <article class="service-card"><div class="card-top"><span class="service-icon">⌁</span><span class="card-number">01 / DEVOPS</span></div><h3>DevOps<br>и инфраструктура</h3><p>Делаем выпуск изменений более предсказуемым и сокращаем ручную работу — чтобы команда могла быстрее развивать продукт.</p><ul><li>Инфраструктура и её автоматизация</li><li>Пайплайны сборки и доставки</li><li>Контроль состояния сервисов</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Обсудить DevOps">↗</a></article>
        <article class="service-card"><div class="card-top"><span class="service-icon icon-green">⎔</span><span class="card-number">02 / IT OPS</span></div><h3>IT-аутсорсинг<br>и поддержка</h3><p>Снимаем с вашей команды рутину поддержки и помогаем держать рабочую IT-среду под контролем.</p><ul><li>Администрирование серверов и сетей</li><li>Поддержка пользователей и сервисов</li><li>Безопасность и резервное копирование</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Обсудить IT-аутсорсинг">↗</a></article>
        <article class="service-card"><div class="card-top"><span class="service-icon icon-pink">{ }</span><span class="card-number">03 / BACKEND</span></div><h3>Backend-<br>разработка</h3><p>Помогаем запускать новые цифровые сервисы и развивать существующие — от API и интеграций до серверной логики.</p><ul><li>API и интеграции</li><li>Высоконагруженные сервисы</li><li>Миграции и модернизация</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Обсудить backend-разработку">↗</a></article>
      </div>
    </div></section>

    <TechStack locale={locale} />

    <section class="approach section" id="approach"><div class="wrap approach-layout"><div class="approach-intro"><div class="eyebrow"><span class="section-no">03</span> КАК МЫ РАБОТАЕМ</div><h2>Понятно бизнесу.<br><span class="accent">Надёжно инженерам.</span></h2><p>Фиксируем цели, этапы и ответственность. Вы понимаете, что делаем и зачем; инженеры — как это поддерживать и развивать.</p><div class="experience-note"><span>Занимаемся коммерческой<br>разработкой</span><b>с 2005 года</b></div></div><div class="steps"><article class="step"><span class="step-no">01</span><div><h3>Согласуем цель</h3><p>Определяем, что должно измениться для бизнеса и по каким признакам поймём, что задача решена.</p></div><span class="step-arrow">↗</span></article><article class="step"><span class="step-no">02</span><div><h3>Показываем путь</h3><p>Разбиваем работу на этапы, согласуем приоритеты и сроки. Объясняем варианты и их последствия простым языком.</p></div><span class="step-arrow">↗</span></article><article class="step"><span class="step-no">03</span><div><h3>Доводим до результата</h3><p>Внедряем решение, документируем его и передаём знания — чтобы система оставалась управляемой и после запуска.</p></div><span class="step-arrow">↗</span></article></div></div></section>

    <section class="about section" id="about"><div class="wrap about-layout"><div class="about-mark"><img class="about-logo" src="assets/logo-stacked.svg" alt="Let's make IT"><span class="about-orbit"></span><span class="about-label">LET'S MAKE IT<br>WORK BETTER.</span></div><div class="about-copy"><div class="eyebrow"><span class="section-no">04</span> LET'S MAKE IT</div><h2>Технический партнёр<br><span class="muted">для вашего бизнеса.</span></h2><p>Let's make IT помогает компаниям развивать продукты и опираться на технологии без лишней сложности. Мы соединяем бизнес-контекст с инженерной практикой: создаём решения, которые отвечают текущим задачам и готовы к дальнейшему развитию.</p><div class="values"><div><b>01</b><span>Думаем о людях,<br>а не только о системах</span></div><div><b>02</b><span>Говорим прямо<br>и держим слово</span></div><div><b>03</b><span>Строим надолго,<br>не на один релиз</span></div></div></div></div></section>

    <section class="contact section" id="contact"><div class="wrap contact-panel"><div class="contact-orb"></div><div class="contact-content"><div class="eyebrow"><span class="section-no">05</span> СЛЕДУЮЩИЙ ШАГ</div><h2>Есть задача?<br><span class="accent">Давайте обсудим.</span></h2><p>Опишите задачу бизнеса — вместе определим подходящий технический следующий шаг.</p><a class="button button-light" href="#contact" data-open-contact>Обсудить задачу <span>↗</span></a></div><div class="contact-side"><span class="contact-caption">LET'S BUILD SOMETHING<br>THAT WORKS.</span><a class="contact-email" href={siteConfig.contactEmail ? 'mailto:' + siteConfig.contactEmail : undefined} hidden={!siteConfig.contactEmail}>{siteConfig.contactEmail}</a><div class="social-links" aria-label="Связаться в соцсетях"><a href={siteConfig.telegramUrl || undefined} hidden={!siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Написать нам в Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 4.2 18.4 19c-.24 1.05-.86 1.3-1.74.81l-4.8-3.54-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.89 8.9-8.04c.39-.35-.09-.55-.6-.2L6.2 12.96l-4.7-1.47c-1.02-.32-1.04-1.02.22-1.5L20.1 2.82c.85-.31 1.6.21 1.5 1.38Z"/></svg></a><a href={siteConfig.linkedinUrl || undefined} hidden={!siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Let's make IT в LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.3 18H5.8V9.7h2.5V18ZM7 8.6a1.45 1.45 0 1 1 0-2.9 1.45 1.45 0 0 1 0 2.9ZM18.2 18h-2.5v-4c0-.95-.02-2.17-1.32-2.17-1.32 0-1.52 1.03-1.52 2.1V18h-2.5V9.7h2.4v1.14h.04c.33-.63 1.15-1.3 2.37-1.3 2.54 0 3.01 1.67 3.01 3.84V18Z"/></svg></a></div></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#top"><img src="assets/logo.svg" alt=""><span class="brand-name">Let's make IT</span></a><span class="copyright">© <time id="current-year"></time> Let's make IT. Технологии, которые работают.</span><div class="social-links" aria-label="Связаться в соцсетях"><a href={siteConfig.telegramUrl || undefined} hidden={!siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Написать нам в Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 4.2 18.4 19c-.24 1.05-.86 1.3-1.74.81l-4.8-3.54-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.89 8.9-8.04c.39-.35-.09-.55-.6-.2L6.2 12.96l-4.7-1.47c-1.02-.32-1.04-1.02.22-1.5L20.1 2.82c.85-.31 1.6.21 1.5 1.38Z"/></svg></a><a href={siteConfig.linkedinUrl || undefined} hidden={!siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Let's make IT в LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.3 18H5.8V9.7h2.5V18ZM7 8.6a1.45 1.45 0 1 1 0-2.9 1.45 1.45 0 0 1 0 2.9ZM18.2 18h-2.5v-4c0-.95-.02-2.17-1.32-2.17-1.32 0-1.52 1.03-1.52 2.1V18h-2.5V9.7h2.4v1.14h.04c.33-.63 1.15-1.3 2.37-1.3 2.54 0 3.01 1.67 3.01 3.84V18Z"/></svg></a></div><a href="#top" class="back-top">Наверх ↑</a></div></footer>

  <ContactDialog locale={locale} />
</SiteLayout>
