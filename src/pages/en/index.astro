---
import { siteConfig } from '../../lib/siteConfig';
import ContactDialog from '../../components/ContactDialog.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import TechStack from '../../components/TechStack.astro';
const locale = 'en';
const title = "DevOps and backend for business — Let's make IT";
const description = 'DevOps, IT outsourcing and backend development for businesses. IT infrastructure support, API development and process automation. Commercial software development since 2005.';
const socialDescription = 'We support IT infrastructure, automate processes and build backend systems. Engineering expertise focused on your business goals.';
---
<SiteLayout locale={locale} title={title} description={description} socialDescription={socialDescription}>

  <header class="header">
    <a class="brand" href="#top" aria-label="Let's make IT — home">
      <img src="../assets/logo.svg" alt=""><span class="brand-name">Let's make IT</span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      <a href="#services">Services</a><a href="#techcard">Technology</a><a href="#approach">Approach</a><a href="#about">About</a>
    </nav>
    <a class="language-switch" href="../?lang=ru" hreflang="ru" lang="ru" aria-label="Русская версия">RU</a>
    <a class="header-cta" href="#contact" data-open-contact >Discuss a project <span>↗</span></a>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
  </header>

  <main id="top">
    <section class="hero wrap">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> Technology partner for business <span class="eyebrow-line"></span> 01 / 05</div>
        <h1>Technology<br>that helps your<br><span class="accent">business grow.</span></h1>
        <p class="hero-text">We help you grow your products and keep IT under control: supporting infrastructure, taking care of technical operations and building backend systems. Engineering expertise, focused on your business goals.</p>
        <div class="hero-actions"><a class="button button-primary" href="#contact" data-open-contact >Tell us about your project <span>↗</span></a><a class="text-link" href="#services" >How we can help <span>↓</span></a></div>
        <div class="hero-meta"><span>Business-minded</span><span>·</span><span>Engineering expertise</span><span>·</span><span>Built for growth</span></div>
      </div>
      <div class="hero-art" aria-label="Illustration of IT infrastructure architecture">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="art-grid"></div>
        <div class="terminal-card"><div class="terminal-top"><span></span><span></span><span></span><b>deploy.sh</b></div><div class="terminal-body"><p><i>$</i> infrastructure.apply()</p><p class="terminal-muted">Planning infrastructure...</p><p class="terminal-success">✓ 12 resources ready</p><p><i>$</i> service.status</p><div class="health"><span>API</span><div><i></i></div><b>operational</b></div><div class="health"><span>DB</span><div><i></i></div><b>operational</b></div><div class="health"><span>CI/CD</span><div><i></i></div><b>operational</b></div><p class="cursor-line"><i>$</i> <span class="cursor"></span></p></div></div>
        <div class="floating-tag tag-top"><span class="tag-icon">↗</span><div><b>Stability</b><small>at the heart of every solution</small></div></div>
        <div class="floating-tag tag-bottom"><span class="tag-icon green">⌘</span><div><b>Built to scale</b><small>Ready to grow</small></div></div>
        <div class="art-index">INFRASTRUCTURE / 001</div>
      </div>
      <a href="#services" class="scroll-hint"><span></span> Scroll to explore</a>
    </section>

    <section class="services section" id="services"><div class="wrap">
      <div class="section-head"><div><div class="eyebrow"><span class="section-no">01</span> WHAT WE DO</div><h2>IT that works<br><span class="muted">for your business.</span></h2></div><p>We support your infrastructure, take IT operations off your plate and build backend systems—so your team can focus on the product and your customers.</p></div>
      <div class="service-grid">
        <article class="service-card"><div class="card-top"><span class="service-icon">⌁</span><span class="card-number">01 / DEVOPS</span></div><h3>DevOps<br>and infrastructure</h3><p>Make releases more predictable and reduce manual work, so your team can focus on moving the product forward.</p><ul><li>Infrastructure and automation</li><li>Build and delivery pipelines</li><li>Service health monitoring</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Discuss DevOps">↗</a></article>
        <article class="service-card"><div class="card-top"><span class="service-icon icon-green">⎔</span><span class="card-number">02 / IT OPS</span></div><h3>IT outsourcing<br>and support</h3><p>We take routine IT support off your team’s plate and help keep your working environment under control.</p><ul><li>Server and network administration</li><li>User and service support</li><li>Security and backups</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Discuss IT outsourcing">↗</a></article>
        <article class="service-card"><div class="card-top"><span class="service-icon icon-pink">{ }</span><span class="card-number">03 / BACKEND</span></div><h3>Backend<br>development</h3><p>We help launch new digital services and evolve existing ones—from APIs and integrations to core business logic.</p><ul><li>APIs and integrations</li><li>Scalable services</li><li>Migrations and modernization</li></ul><a href="#contact" data-open-contact class="card-link" aria-label="Discuss backend development">↗</a></article>
      </div>
    </div></section>

    <TechStack locale={locale} />

    <section class="approach section" id="approach"><div class="wrap approach-layout"><div class="approach-intro"><div class="eyebrow"><span class="section-no">03</span> HOW WE WORK</div><h2>Clear for business.<br><span class="accent">Solid engineering.</span></h2><p>We agree on goals, milestones and ownership. You know what we’re doing and why; engineers know how to support and evolve it.</p><div class="experience-note"><span>Building commercial<br>software</span><b>since 2005</b></div></div><div class="steps"><article class="step"><span class="step-no">01</span><div><h3>Align on the goal</h3><p>We define the business outcome and how we’ll know the work has succeeded.</p></div><span class="step-arrow">↗</span></article><article class="step"><span class="step-no">02</span><div><h3>Map the way forward</h3><p>We break the work into clear phases, align on priorities and timelines, and explain options and trade-offs in plain language.</p></div><span class="step-arrow">↗</span></article><article class="step"><span class="step-no">03</span><div><h3>Deliver and support</h3><p>We implement and document the solution, then share knowledge so it remains manageable after launch.</p></div><span class="step-arrow">↗</span></article></div></div></section>

    <section class="about section" id="about"><div class="wrap about-layout"><div class="about-mark"><img class="about-logo" src="../assets/logo-stacked.svg" alt="Let's make IT"><span class="about-orbit"></span><span class="about-label">LET'S MAKE IT<br>WORK BETTER.</span></div><div class="about-copy"><div class="eyebrow"><span class="section-no">04</span> LET'S MAKE IT</div><h2>Your technical partner<br><span class="muted">for your business.</span></h2><p>Let's make IT helps businesses grow their products and get more from technology—without unnecessary complexity. We connect business context with engineering practice to build solutions for today’s needs and tomorrow’s growth.</p><div class="values"><div><b>01</b><span>People before<br>systems</span></div><div><b>02</b><span>Straight talk<br>and follow-through</span></div><div><b>03</b><span>Built to last,<br>beyond one release</span></div></div></div></div></section>

    <section class="contact section" id="contact"><div class="wrap contact-panel"><div class="contact-orb"></div><div class="contact-content"><div class="eyebrow"><span class="section-no">05</span> NEXT STEP</div><h2>Have a challenge?<br><span class="accent">Let’s talk.</span></h2><p>Tell us what your business needs. Together, we’ll identify the right technical next step.</p><a class="button button-light" href="#contact" data-open-contact >Discuss a project <span>↗</span></a></div><div class="contact-side"><span class="contact-caption">LET'S BUILD SOMETHING<br>THAT WORKS.</span><a class="contact-email" href={siteConfig.contactEmail ? 'mailto:' + siteConfig.contactEmail : undefined} hidden={!siteConfig.contactEmail}>{siteConfig.contactEmail}</a><div class="social-links" aria-label="Connect with us"><a href={siteConfig.telegramUrl || undefined} hidden={!siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Message us on Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 4.2 18.4 19c-.24 1.05-.86 1.3-1.74.81l-4.8-3.54-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.89 8.9-8.04c.39-.35-.09-.55-.6-.2L6.2 12.96l-4.7-1.47c-1.02-.32-1.04-1.02.22-1.5L20.1 2.82c.85-.31 1.6.21 1.5 1.38Z"/></svg></a><a href={siteConfig.linkedinUrl || undefined} hidden={!siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Let's make IT on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.3 18H5.8V9.7h2.5V18ZM7 8.6a1.45 1.45 0 1 1 0-2.9 1.45 1.45 0 0 1 0 2.9ZM18.2 18h-2.5v-4c0-.95-.02-2.17-1.32-2.17-1.32 0-1.52 1.03-1.52 2.1V18h-2.5V9.7h2.4v1.14h.04c.33-.63 1.15-1.3 2.37-1.3 2.54 0 3.01 1.67 3.01 3.84V18Z"/></svg></a></div></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#top"><img src="../assets/logo.svg" alt=""><span class="brand-name">Let's make IT</span></a><span class="copyright">© <time id="current-year"></time> Let's make IT. Technology that works.</span><div class="social-links" aria-label="Connect with us"><a href={siteConfig.telegramUrl || undefined} hidden={!siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Message us on Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 4.2 18.4 19c-.24 1.05-.86 1.3-1.74.81l-4.8-3.54-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.89 8.9-8.04c.39-.35-.09-.55-.6-.2L6.2 12.96l-4.7-1.47c-1.02-.32-1.04-1.02.22-1.5L20.1 2.82c.85-.31 1.6.21 1.5 1.38Z"/></svg></a><a href={siteConfig.linkedinUrl || undefined} hidden={!siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Let's make IT on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.3 18H5.8V9.7h2.5V18ZM7 8.6a1.45 1.45 0 1 1 0-2.9 1.45 1.45 0 0 1 0 2.9ZM18.2 18h-2.5v-4c0-.95-.02-2.17-1.32-2.17-1.32 0-1.52 1.03-1.52 2.1V18h-2.5V9.7h2.4v1.14h.04c.33-.63 1.15-1.3 2.37-1.3 2.54 0 3.01 1.67 3.01 3.84V18Z"/></svg></a></div><a href="#top" class="back-top">Back to top ↑</a></div></footer>

  <ContactDialog locale={locale} />
</SiteLayout>
